<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forçar HTTPS (obrigatório para Câmera, Microfone/Voz e PWA na Hostinger)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Não reescrever arquivos existentes, diretórios ou verificação SSL (.well-known)
  RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC,OR]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Fallback SPA para index.html preservando query params (ex: ?mode=hdmi)
  RewriteRule ^ index.html [L,QSA]
</IfModule>

# Cabeçalhos de Segurança e Permissões de Estúdio (Câmera e Microfone)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(self), microphone=(self), fullscreen=(self)"

  # Evitar cache agressivo no HTML, Service Worker e Manifesto PWA após atualizações
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache longo para assets versionados pelo Vite
  <FilesMatch "\.(js|css|woff2|png|svg|jpg|jpeg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
