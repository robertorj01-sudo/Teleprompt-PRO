{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public-safe user profile and subscription metadata for Teleprompter Pro",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication user UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user",
          "minLength": 1,
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL",
          "maxLength": 500
        },
        "providerId": {
          "type": "string",
          "description": "Authentication provider used",
          "enum": ["google.com", "apple.com", "microsoft.com", "password"]
        },
        "planType": {
          "type": "string",
          "description": "User plan tier",
          "enum": ["free", "lifetime"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update timestamp"
        }
      },
      "required": ["uid", "displayName", "providerId", "planType", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII and legal consent info for a registered user",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication user UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified user email address",
          "minLength": 3,
          "maxLength": 254
        },
        "termsAccepted": {
          "type": "boolean",
          "description": "Whether user accepted Terms and Privacy Policy"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp"
        }
      },
      "required": ["uid", "email", "termsAccepted", "createdAt", "updatedAt"]
    },
    "UserScript": {
      "title": "UserScript",
      "description": "Saved teleprompter script synchronized for an authenticated user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Script document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the user who owns this script",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Script title",
          "minLength": 1,
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "description": "Full script body text",
          "minLength": 0,
          "maxLength": 100000
        },
        "wordCount": {
          "type": "number",
          "description": "Word count of script"
        },
        "estimatedMinutes": {
          "type": "number",
          "description": "Estimated reading time in minutes"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Script creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp"
        }
      },
      "required": ["id", "ownerId", "title", "content", "wordCount", "estimatedMinutes", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile documents keyed by Firebase Auth UID"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII subcollection for user email and terms acceptance"
    },
    "/users/{userId}/scripts/{scriptId}": {
      "schema": { "$ref": "#/entities/UserScript" },
      "description": "User-owned teleprompter scripts synced across devices"
    }
  }
}
