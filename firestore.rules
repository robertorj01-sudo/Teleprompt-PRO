rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'providerId', 'planType', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'providerId', 'planType', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.providerId is string
        && data.providerId.size() <= 32
        && data.providerId in ['google.com', 'apple.com', 'microsoft.com', 'password']
        && data.planType is string
        && data.planType.size() <= 16
        && data.planType in ['free', 'lifetime']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'termsAccepted', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'termsAccepted', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.email == request.auth.token.email
        && data.termsAccepted is bool
        && data.termsAccepted == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserScript(data, userId, scriptId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'content', 'wordCount', 'estimatedMinutes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'content', 'wordCount', 'estimatedMinutes', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 128
        && data.id == scriptId
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.content is string
        && data.content.size() >= 0
        && data.content.size() <= 100000
        && data.wordCount is number
        && data.wordCount >= 0
        && data.wordCount <= 100000
        && data.estimatedMinutes is number
        && data.estimatedMinutes >= 0
        && data.estimatedMinutes <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().planType == 'free'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().planType == existing().planType
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'providerId', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);

      // Isolated PII subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && docId == 'info' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'termsAccepted', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(docId) && docId == 'info' && isOwner(userId);
      }

      // User scripts subcollection
      match /scripts/{scriptId} {
        allow get: if isValidId(userId) && isValidId(scriptId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(scriptId)
          && isOwner(userId)
          && isValidUserScript(incoming(), userId, scriptId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(scriptId)
          && isOwner(userId)
          && isValidUserScript(incoming(), userId, scriptId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'wordCount', 'estimatedMinutes', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(scriptId) && isOwner(userId) && existing().ownerId == request.auth.uid;
      }
    }
  }
}
